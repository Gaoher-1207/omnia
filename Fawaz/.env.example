# Used by docker-compose.yml. Copy to .env (never commit it).
# REQUIRED
POSTGRES_PASSWORD=
# REQUIRED: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=
# OPTIONAL: set to anthropic and fill AI_API_KEY
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=claude-sonnet-5
