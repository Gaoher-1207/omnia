# Copy to backend/.env for local development. Never commit the real file.
# REQUIRED values are marked; everything else has a safe default.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# REQUIRED in production (PostgreSQL). Local dev falls back to SQLite if unset.
# DATABASE_URL=postgresql+psycopg://omnia:<password>@localhost:5432/omnia
DATABASE_URL=sqlite:///./omnia.db

# REQUIRED in production: 32+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development an empty value uses a temporary secret (everyone is signed out on restart).
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Browser origins allowed to call the API (only matters for Flutter web).
CORS_ORIGINS=http://localhost:5173

# Public URL of this API (e.g. https://api.example.com). Used for calendar subscription links.
PUBLIC_BASE_URL=

# Food-photo provider: rules (offline) or anthropic. Independent of OmniAI below.
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Daily planner provider: rules, anthropic, ollama (local), or openrouter.
PLANNER_AI_PROVIDER=rules
AI_TIMEOUT_SECONDS=20
AI_RATE_LIMIT_PER_HOUR=20
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Production on Railway: set PLANNER_AI_PROVIDER=openrouter and ASSISTANT_PROVIDER=openrouter.
# Local development: set both to ollama; use ASSISTANT_BASE_URL=http://127.0.0.1:11434
# and ASSISTANT_MODEL=qwen3:8b. The Ollama server stays local.
# Ask Omnia (POST /api/ai/chat): "off" answers 503; "ollama" uses local Ollama;
# "openrouter" uses the server-side key and model chain above.
# Pull the local model first: ollama pull qwen3:8b
# In Docker, point the URL at the host, e.g. http://host.docker.internal:11434
ASSISTANT_PROVIDER=off
ASSISTANT_BASE_URL=http://localhost:11434
ASSISTANT_MODEL=qwen3:8b
ASSISTANT_TIMEOUT_SECONDS=60
ASSISTANT_CONTEXT_TOKENS=8192
ASSISTANT_RATE_LIMIT_PER_HOUR=60

AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BYTES=8388608

# Legacy shared local OmniAI chat + daily planning. New subsystem settings take precedence.
# If unset, older deployments can continue using the shared value.
# Values not specified here inherit ASSISTANT_* for launcher compatibility.
# OMNIA_AI_PROVIDER=ollama
# OMNIA_AI_MODEL=qwen3:8b
# OMNIA_AI_BASE_URL=http://127.0.0.1:11434
# OMNIA_AI_TIMEOUT_SECONDS=120
# OMNIA_AI_CONTEXT_TOKENS=8192
