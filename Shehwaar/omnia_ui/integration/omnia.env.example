# OMNIA frontend settings. Copy to integration/omnia.env (git-ignored) and
# pass it with --dart-define-from-file, or use run_frontend.ps1 -EnvFile.
# Flutter reads these at build time; they are not read at runtime.

# "api" signs in against a backend. Leave empty (or remove) for mock mode.
OMNIA_DATA=api

# The backend's API root, including /api, with no trailing slash needed.
# Leave empty to use the debug defaults:
#   Android emulator -> http://10.0.2.2:8000/api
#   web / iOS / desktop -> http://localhost:8000/api
# Release builds have no default and must set it (use https).
#
# Examples:
#   OMNIA_API_BASE_URL=http://10.0.2.2:8000/api        # emulator -> this computer
#   OMNIA_API_BASE_URL=http://192.168.1.20:8000/api    # phone on the same Wi-Fi
#   OMNIA_API_BASE_URL=https://omnia.example.com/api   # a deployed backend
OMNIA_API_BASE_URL=
