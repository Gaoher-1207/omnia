# Copy to .env.launcher in this directory for machine-specific settings.
# Plain KEY=value, without quotes. These are process-local, never global.
OLLAMA_EXE=F:\Ollama\ollama.exe
OLLAMA_MODELS=F:\OllamaModels
ANDROID_AVD=Pixel_9
ASSISTANT_PROVIDER=ollama
ASSISTANT_BASE_URL=http://127.0.0.1:11434
ASSISTANT_MODEL=qwen3:8b
ASSISTANT_TIMEOUT_SECONDS=180
